{
	"$schema": "../node_modules/@companion-module/base/assets/manifest.schema.json",
	"id": "ecamm-live",
	"name": "ecamm-live",
	"shortname": "ecammlive",
	"description": "Control Ecamm Live on macOS over its Remote Control API",
	"version": "0.0.0",
	"license": "MIT",
	"repository": "https://github.com/bitfocus/companion-module-ecamm-live.git",
	"bugs": "https://github.com/bitfocus/companion-module-ecamm-live/issues",
	"maintainers": [
		{
			"name": "Justin James",
			"email": "digitaldrummerj@gmail.com"
		}
	],
	"legacyIds": [],
	"runtime": {
		"type": "node22",
		"api": "nodejs-ipc",
		"apiVersion": "0.0.0",
		"entrypoint": "../dist/main.js"
	},
	"manufacturer": "ecamm",
	"products": ["Live"],
	"keywords": ["streaming", "recordings", "podcast", "present"],
	"bonjourQueries": {
		"ecammHost": {
			"type": "ecammliveremote",
			"protocol": "tcp"
		}
	}
}
